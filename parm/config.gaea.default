########################################
# User configuration for IVT plotting
########################################
# Time selectors
DATE_TYPE=INIT           # INIT | VALID
DATE=${YEAR}${MONTH}${DAY}            # YYYYMMDD
HOUR=${IHOUR}                  # HH (00-23)
FHR=${FHOUR}                   # integer hours; used for spatial maps
FHRS="0-120:3"                 # integer hours in format "START-END:INCREMENT"; used for meteograms

# What to plot
MODEL=arafs             # gfsv16 | gfsv17 | arafs
VAR=${VARIABLE}                  # currently only IVT supported
DOMAIN=nepac        # see domain map in ivt_from_grib.py
POINT_LAT="47.6061"  # degrees; used for meteograms
POINT_LON="122.3328" # degrees; used for meteograms

# Paths
HOME_DIR=~/AR_spatial_maps        # top of this repo
COMOUT=/gpfs/f6/scratch/Marcel.Caron/ar-cpu/AR_maps/plots          # will be created
TMP=~/tmp/ivt_tmp              # scratch
FIX=${HOME_DIR}/fix                   # logos, etc. (optional for now)

# Model head directories (everything before date subpaths)
HEAD_GFSV16=/lfs/h1/ops/prod/com/gfs/v16.3
HEAD_GFSV17=/lfs/h1/ops/prod/com/gfs/v17.0   # adjust if/when used
HEAD_GDAS=/lfs/h1/ops/prod/com/gdas/v16.3
HEAD_ARAFS=/gpfs/f6/drsa-hurr4/scratch/Keqin.Wu/scrub/ARAFS_Exp4_alaska_4_a/com

# Filename templates (bash will expand these; {FHR3} -> zero-padded)
# GFSv16:
TEMPLATE_GFSV16='{HEAD_GFSV16}/gfs.{IDATE}/{IHOUR}/atmos/gfs.t{IHOUR}z.pgrb2.0p25.f{FHR3}'
TEMPLATE_GFSV17='{HEAD_GFSV17}/gfs.{IDATE}/{IHOUR}/atmos/gfs.t{IHOUR}z.pgrb2.0p25.f{FHR3}'
TEMPLATE_GDAS='{HEAD_GDAS}/gfs.{IDATE}/{IHOUR}/atmos/gfs.t{IHOUR}z.pgrb2.0p25.f{FHR3}'
# ARAFS:
TEMPLATE_ARAFS='{HEAD_ARAFS}/{IDATE}{IHOUR}/00E/arafs.{IDATE}{IHOUR}.f{FHR3}.grb2'

# Plot style / options
QUIVER_STRIDE=${QUIVER_STRIDE}          # thin wind vectors (grid stride)
SLP_CONTOURS="980 996 1004 1012 1020 1028 1036"  # hPa labels (optional)
BOOL_ANALYSIS=${BOOL_ANL}
