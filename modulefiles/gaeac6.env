#!/bin/bash
# Environment setup for AR plotting workflows on Gaea C6

module reset
source "${TOPDIR}/versions/gaeac6.ver"

########################################
# Compiler / core environment
########################################
module load PrgEnv-intel/${PrgEnvintel_ver}
module load intel/${intel_ver}
module load cray-mpich/${craympich_ver}

########################################
# Library dependencies for GRIB2 / plotting
########################################
module load geos/${geos_ver}
module load imagemagick/${imagemagick_ver}

########################################
# GRIB utilities
########################################
#module load grib_util/${grib_util_ver}
module load wgrib2/${wgrib2_ver}

########################################
# Python environment
########################################
module load miniforge3/${miniforge3_ver}
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /ncrc/proj/ar-cpu/Marcel.Caron/conda/envs/ar
echo "Activated Conda env: $(basename $CONDA_PREFIX)"
echo "Python executable: $(which python)"

########################################
# Custom paths for locally installed libs
########################################
export HOMEDIR=${HOMEDIR:-$HOME}
export CARTOPY_DATA_DIR=/gpfs/f6/ar-cpu/proj-shared/fix/cartopy

########################################
# Final diagnostics
########################################
echo "Environment setup complete."
echo "Using Python from: $(which python3)"
module list

#set +x

