#!/bin/bash
# Environment setup for AR plotting workflows on WCOSS2

module reset
source "${TOPDIR}/versions/wcoss2.ver"

########################################
# Compiler / core environment
########################################
module load prod_envir/${prod_envir_ver}
module load PrgEnv-intel/${PrgEnvintel_ver}
module load intel/${intel_ver}
module load cray-mpich/${craympich_ver}
module load cray-pals/${craypals_ver}
module load prod_util/${prod_util_ver}

########################################
# Library dependencies for GRIB2 / plotting
########################################
module load libjpeg/${libjpeg_ver}
module load libpng/${libpng_ver}
module load zlib/${zlib_ver}
module load jasper/${jasper_ver}
module load proj/${proj_ver}
module load geos/${geos_ver}
module load imagemagick/${imagemagick_ver}

########################################
# GRIB utilities
########################################
module load grib_util/${grib_util_ver}
module load wgrib2/${wgrib2_ver}

########################################
# NetCDF and other science libs
########################################
module load netcdf/${netcdf_ver}

########################################
# Python environment
########################################
module load python/3.8.6
module use /lfs/h1/mdl/nbm/save/apps/modulefiles
module load python-modules/3.8.6

########################################
# Other utilities
########################################
module load libjpeg-turbo/${libjpeg_turbo_ver}


########################################
# Custom PYTHONPATH for locally installed libs
########################################
export HOMEDIR=${HOMEDIR:-$HOME}
export PYTHONPATH="${PYTHONPATH}:/lfs/h2/emc/lam/noscrub/Benjamin.Blake/python:${HOMEDIR}/modulefiles"

########################################
# Final diagnostics
########################################
echo "Environment setup complete."
echo "Using Python from: $(which python3)"
echo "PYTHONPATH = ${PYTHONPATH}"
module list

